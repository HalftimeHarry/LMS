# =========================================================
# Production Environment Variables
# =========================================================
# Copy this file to .env and fill in real values.
# Never commit .env to GitHub — it is in .gitignore.
# In production, set these in Netlify → Site Settings → Environment Variables.

# ---------------------------------------------------------
# PocketBase (Railway)
# ---------------------------------------------------------

# Public PocketBase URL — safe to expose to the browser
PUBLIC_POCKETBASE_URL=https://pocketbase-production-2547.up.railway.app

# Public application URL — used in emails and redirects
PUBLIC_APP_URL=https://theblizzardofodds.com

# Server-side only — NEVER expose to the browser
POCKETBASE_ADMIN_EMAIL=admin@theblizzardofodds.com
POCKETBASE_ADMIN_PASSWORD=replace_with_secure_password

# ---------------------------------------------------------
# NFL Odds API
# https://the-odds-api.com/
# ---------------------------------------------------------

ODDS_API_KEY=your_odds_api_key

# ---------------------------------------------------------
# Cloudflare Turnstile
# https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank in development — CAPTCHA is skipped when unset.
# ---------------------------------------------------------

# Public key — safe for browser/client use
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Secret key — server-side only
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ---------------------------------------------------------
# EmailJS
# https://www.emailjs.com/
# ---------------------------------------------------------

# Public browser-safe key
PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Server-side private key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# EmailJS service configuration
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_WELCOME_TEMPLATE_ID=your_emailjs_welcome_template_id
