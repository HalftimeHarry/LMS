# Frontend — set these in Netlify environment variables for production
PUBLIC_POCKETBASE_URL=https://api.yourdomain.com

# Server-side only — never expose to the client
# Used by scripts/ and server hooks that need admin access
POCKETBASE_ADMIN_EMAIL=admin@yourdomain.com
POCKETBASE_ADMIN_PASSWORD=changeme

# NFL data provider (The Odds API — https://the-odds-api.com/)
ODDS_API_KEY=
