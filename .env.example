# Frontend — set these in Netlify environment variables for production
PUBLIC_POCKETBASE_URL=https://pocketbase-production-2547.up.railway.app
# Base URL of the app — used in emails (e.g. https://lmspool.com)
PUBLIC_APP_URL=https://your-app-domain.com

# Server-side only — never expose to the client
# Used by scripts/ and server hooks that need admin access
POCKETBASE_ADMIN_EMAIL=admin@yourdomain.com
POCKETBASE_ADMIN_PASSWORD=changeme

# NFL data provider (The Odds API — https://the-odds-api.com/)
ODDS_API_KEY=

# Cloudflare Turnstile CAPTCHA — https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank in development — CAPTCHA is skipped when these are not set.
# Add a Turnstile site in the Cloudflare dashboard, then copy the keys here.
# PUBLIC_TURNSTILE_SITE_KEY goes in Netlify environment variables (public).
# TURNSTILE_SECRET_KEY goes in Netlify environment variables (secret, server-only).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# EmailJS — https://www.emailjs.com/
# Used for password reset and any transactional emails sent from the client.
# PUBLIC_EMAILJS_PUBLIC_KEY is safe to expose to the browser.
# EMAILJS_PRIVATE_KEY is server-only — never expose to the client.
PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_WELCOME_TEMPLATE_ID=your_welcome_template_id
